{
  "source": {
    "url": "https://www.cms.gov/medicare/payment/prospective-payment-systems/hospital-outpatient-pps/quarterly-addenda-updates",
    "file_type": "xlsx",
    "skip_rows": 2
  },
  "paths": {
    "download_dir": "downloaded_input",
    "initial_output": "initial_parquet",
    "final_output": "final_parquet"
  },
  "columns_mapper": [
    {
      "source_col_name": "APC",
      "new_name": "apc",
      "pandas_dtype": "string",
      "input_spark_type": "StringType",
      "spark_type": "StringType"
    },
    {
      "source_col_name": "Group Title",
      "new_name": "group_title",
      "pandas_dtype": "string",
      "input_spark_type": "StringType",
      "spark_type": "StringType"
    },
    {
      "source_col_name": "SI",
      "new_name": "si",
      "pandas_dtype": "string",
      "input_spark_type": "StringType",
      "spark_type": "StringType"
    },
    {
      "source_col_name": "Payment Rate",
      "new_name": "payment_rate",
      "pandas_dtype": "string",
      "input_spark_type": "StringType",
      "spark_type": "DecimalType",
      "clean_as_numeric": true,
      "precision": 10,
      "scale": 3
    },
    {
      "source_col_name": "Minimum Unadjusted Copayment",
      "new_name": "min_unadjusted_copay",
      "pandas_dtype": "string",
      "input_spark_type": "StringType",
      "spark_type": "DecimalType",
      "clean_as_numeric": true,
      "precision": 10,
      "scale": 2
    },
    {
      "source_col_name": "Adjusted Beneficiary Copayment",
      "new_name": "adj_benefi_copay",
      "pandas_dtype": "string",
      "input_spark_type": "StringType",
      "spark_type": "DecimalType",
      "clean_as_numeric": true,
      "precision": 10,
      "scale": 2
    }
  ]
}
